<style>
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    background: #0d1117;
    color: #e6edf3;
    padding: 48px;
    margin: 0;
  }
  .layout {
    display: flex;
    gap: 32px;
    max-width: 960px;
  }
  h1 {
    font-size: 22px;
    font-weight: 600;
    margin-bottom: 28px;
    color: #f0f6fc;
    letter-spacing: -0.3px;
  }
  h2 {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #8b949e;
    margin: 0 0 14px 0;
  }
  .main-col {
    flex: 1;
    min-width: 0;
  }
  .sidebar {
    width: 240px;
    flex-shrink: 0;
  }
  .event-feed {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .event-item {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 10px;
    padding: 16px 20px;
    margin-bottom: 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: border-color 0.15s ease;
  }
  .event-item:hover {
    border-color: #58a6ff;
  }
  .event-type {
    display: inline-block;
    background: rgba(88, 166, 255, 0.15);
    color: #79c0ff;
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    padding: 3px 9px;
    border-radius: 12px;
    margin-right: 10px;
  }
  .event-meta {
    color: #8b949e;
    font-size: 13.5px;
  }
  .event-meta strong {
    color: #e6edf3;
    font-weight: 600;
  }
  .event-time {
    color: #6e7681;
    font-size: 12.5px;
    white-space: nowrap;
    margin-left: 16px;
  }
  .sidebar-card {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 10px;
    padding: 18px 20px;
    margin-bottom: 20px;
  }
  .stat-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 7px 0;
    font-size: 13.5px;
  }
  .stat-row .name {
    color: #e6edf3;
    display: flex;
    align-items: center;
  }
  .avatar {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #30363d;
    margin-right: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 600;
    color: #79c0ff;
  }
  .stat-row .count {
    color: #8b949e;
    font-variant-numeric: tabular-nums;
  }
  .big-stat {
    font-size: 28px;
    font-weight: 700;
    color: #f0f6fc;
  }
  .big-stat-label {
    color: #8b949e;
    font-size: 13px;
    margin-top: 2px;
  }
</style>

<meta http-equiv="refresh" content="10">

<h1>Repo Activity</h1>

<div class="layout">
  <div class="main-col">
    <ul class="event-feed">
      <% @events.each do |event| %>
        <li class="event-item">
          <div>
            <span class="event-type"><%= event.event_type %></span>
            <span class="event-meta">
              <% if event.action.present? %>(<%= event.action %>)<% end %>
              by <strong><%= event.actor %></strong> on <%= event.repo_full_name %>
            </span>
          </div>
          <span class="event-time"><%= time_ago_in_words(event.occurred_at) %> ago</span>
        </li>
      <% end %>
    </ul>
  </div>

  <div class="sidebar">
    <div class="sidebar-card">
      <div class="big-stat"><%= @total_events %></div>
      <div class="big-stat-label">total events</div>
    </div>

    <div class="sidebar-card">
      <h2>Top Contributors</h2>
      <% @top_contributors.each do |actor, count| %>
        <div class="stat-row">
          <span class="name">
            <span class="avatar"><%= actor.first.upcase %></span>
            <%= actor %>
          </span>
          <span class="count"><%= count %></span>
        </div>
      <% end %>
    </div>

    <div class="sidebar-card">
      <h2>By Event Type</h2>
      <% @event_type_counts.each do |type, count| %>
        <div class="stat-row">
          <span class="name"><%= type %></span>
          <span class="count"><%= count %></span>
        </div>
      <% end %>
    </div>
  </div>
</div>