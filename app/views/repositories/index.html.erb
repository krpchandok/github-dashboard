<style>
  @import url('https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&display=swap');
  * { box-sizing: border-box; }
  body {
    font-family: 'Quicksand', sans-serif;
    background: #fef6fa;
    color: #6b5768;
    padding: 64px 72px;
    margin: 0;
  }
  .header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1100px;
    margin-bottom: 40px;
  }
  .title-wrap { display: flex; align-items: center; gap: 12px; }
  .title-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #ffc2dd;
    box-shadow: 6px 2px 0 #c9b8f5, -4px 8px 0 #b8e8d8;
  }
  h1 {
    font-size: 28px;
    font-weight: 700;
    color: #7a5c74;
    margin: 0;
  }
  .sync-btn {
    background: #fff;
    color: #b06a99;
    border: 2px solid #f6cfe4;
    padding: 10px 22px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 13.5px;
    font-family: 'Quicksand', sans-serif;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .sync-btn:hover {
    background: #fff0f7;
    border-color: #f6a8cf;
  }
  .repo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
    max-width: 1100px;
  }
  .repo-card {
    background: #ffffff;
    border: 2px solid #fce4f0;
    border-radius: 22px;
    padding: 24px;
    text-decoration: none;
    color: inherit;
    display: block;
    position: relative;
    overflow: hidden;
    transition: all 0.15s ease;
  }
  .repo-card::before {
    content: "";
    position: absolute;
    top: -20px;
    right: -20px;
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: #fdeaf3;
    opacity: 0.7;
  }
  .repo-card:hover {
    border-color: #f6a8cf;
    transform: translateY(-3px) rotate(-0.5deg);
  }
  .repo-top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    position: relative;
  }
  .repo-icon {
    width: 34px;
    height: 34px;
    border-radius: 12px;
    background: #d6c6f7;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #7a5c99;
    font-weight: 700;
    font-size: 14px;
    flex-shrink: 0;
  }
  .repo-name {
    font-weight: 600;
    font-size: 15px;
    color: #5c4757;
  }
  .repo-desc {
    font-size: 13px;
    color: #a58ea0;
    margin-bottom: 18px;
    min-height: 18px;
    line-height: 1.5;
    position: relative;
  }
  .repo-stats {
    display: flex;
    gap: 14px;
    font-size: 11.5px;
    color: #c9a8bd;
    position: relative;
  }
  .repo-stats span {
    background: #fdf1f7;
    padding: 4px 10px;
    border-radius: 999px;
  }
  .empty-state {
    text-align: center;
    padding: 80px 20px;
    color: #c9a8bd;
    font-size: 14px;
  }
</style>

<div class="header-row">
  <div class="title-wrap">
    <div class="title-dot"></div>
    <h1>Repo activity</h1>
  </div>
  <%= button_to "Sync from GitHub", sync_repositories_path, method: :post, class: "sync-btn" %>
</div>

<% if @repositories.any? %>
  <div class="repo-grid">
    <% @repositories.each do |repo| %>
      <%= link_to repository_path(repo), class: "repo-card" do %>
        <div class="repo-top">
          <div class="repo-icon"><%= repo.full_name.split("/").last.first.upcase %></div>
          <div class="repo-name"><%= repo.full_name %></div>
        </div>
        <div class="repo-desc"><%= repo.about.presence || repo.description.presence || "No description yet" %></div>
        <div class="repo-stats">
          <span><%= repo.language %></span>
          <span>★ <%= repo.stargazers_count %></span>
          <span><%= repo.events.count %> events</span>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="empty-state">No repos synced yet — click "Sync from GitHub" to get started.</div>
<% end %>