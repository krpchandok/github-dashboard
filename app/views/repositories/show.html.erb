<style>
  @import url('https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&display=swap');
  * { box-sizing: border-box; }
  body {
    font-family: 'Quicksand', sans-serif;
    background: #fef6fa;
    color: #6b5768;
    padding: 64px 72px;
    margin: 0;
  }
  .back-link {
    color: #c9a8bd;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 22px;
  }
  .back-link:hover { color: #b06a99; }
  .title-wrap { display: flex; align-items: center; gap: 12px; margin-bottom: 32px; }
  .title-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #ffc2dd;
    box-shadow: 6px 2px 0 #c9b8f5, -4px 8px 0 #b8e8d8;
  }
  h1 {
    font-size: 26px;
    font-weight: 700;
    color: #7a5c74;
    margin: 0;
  }
  .layout {
    display: flex;
    gap: 24px;
    max-width: 1100px;
    align-items: flex-start;
  }
  .main-col { flex: 1.4; min-width: 0; }
  .side-col { flex: 1; min-width: 280px; }
  h2 {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: #c9a8bd;
    margin: 0 0 14px 0;
  }
  .event-item {
    background: #ffffff;
    border: 2px solid #fce4f0;
    border-radius: 18px;
    padding: 14px 18px;
    margin-bottom: 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13.5px;
  }
  .event-type {
    background: #f5ecfc;
    color: #8a67b8;
    font-weight: 700;
    font-size: 10.5px;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 999px;
    margin-right: 10px;
  }
  .card {
    background: #ffffff;
    border: 2px solid #fce4f0;
    border-radius: 22px;
    padding: 22px;
    margin-bottom: 20px;
    position: relative;
    overflow: hidden;
  }
  .card::before {
    content: "";
    position: absolute;
    top: -18px;
    right: -18px;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #fdeaf3;
    opacity: 0.6;
  }
  .contributor-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0;
    font-size: 13.5px;
    position: relative;
  }
  .avatar {
    width: 24px; height: 24px; border-radius: 50%;
    background: #d6c6f7;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 10.5px; font-weight: 700; color: #7a5c99;
    margin-right: 10px;
  }
  .count-pill {
    background: #fdf1f7;
    color: #c9a8bd;
    font-size: 11.5px;
    padding: 3px 10px;
    border-radius: 999px;
  }
  textarea {
    width: 100%;
    min-height: 120px;
    border-radius: 16px;
    border: 2px solid #fce4f0;
    padding: 14px;
    font-family: 'Quicksand', sans-serif;
    font-size: 13.5px;
    color: #6b5768;
    background: #fffafd;
    resize: vertical;
    position: relative;
  }
  textarea:focus {
    outline: none;
    border-color: #f6a8cf;
  }
  .save-btn {
    margin-top: 12px;
    background: #ffd9ec;
    color: #b06a99;
    border: none;
    padding: 10px 22px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 13px;
    font-family: 'Quicksand', sans-serif;
    cursor: pointer;
    position: relative;
  }
  .save-btn:hover { background: #ffcbe3; }
  .empty { color: #c9a8bd; font-size: 13px; }
</style>

<%= link_to "← Back to repos", root_path, class: "back-link" %>
<div class="title-wrap">
  <div class="title-dot"></div>
  <h1><%= @repository.full_name %></h1>
</div>

<div class="layout">
  <div class="main-col">
    <h2>Recent activity</h2>
    <% if @events.any? %>
      <% @events.each do |event| %>
        <div class="event-item">
          <div>
            <span class="event-type"><%= event.event_type %></span>
            by <strong><%= event.actor %></strong>
          </div>
          <span class="empty"><%= time_ago_in_words(event.occurred_at) %> ago</span>
        </div>
      <% end %>
    <% else %>
      <p class="empty">No activity yet.</p>
    <% end %>
  </div>

  <div class="side-col">
    <div class="card">
      <h2>Contributors</h2>
      <% if @contributors.any? %>
        <% @contributors.each do |actor, count| %>
          <div class="contributor-row">
            <span><span class="avatar"><%= actor.first.upcase %></span><%= actor %></span>
            <span class="count-pill"><%= count %></span>
          </div>
        <% end %>
      <% else %>
        <p class="empty">No contributors yet.</p>
      <% end %>
    </div>

    <div class="card">
      <h2>About</h2>
      <%= form_with model: @repository, local: true do |f| %>
        <%= f.text_area :about, placeholder: "Write something about this project..." %>
        <br>
        <%= f.submit "Save", class: "save-btn" %>
      <% end %>
    </div>
  </div>
</div>