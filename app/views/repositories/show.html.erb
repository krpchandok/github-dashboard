<style>
  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap');
  * { box-sizing: border-box; }
  body {
    font-family: 'Poppins', sans-serif;
    background: linear-gradient(135deg, #ffe9f3 0%, #fff0f5 40%, #fdf2ff 100%);
    color: #6b4a5e;
    padding: 56px 64px;
    margin: 0;
  }
  .back-link {
    color: #c98aa8;
    text-decoration: none;
    font-size: 13px;
    display: inline-block;
    margin-bottom: 20px;
  }
  h1 {
    font-size: 26px;
    font-weight: 800;
    color: #d6478a;
    margin: 0 0 24px 0;
  }
  .tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 24px;
  }
  .tab {
    padding: 8px 18px;
    border-radius: 20px;
    text-decoration: none;
    font-size: 13.5px;
    font-weight: 600;
    color: #c98aa8;
    background: rgba(255,255,255,0.6);
    border: 1px solid #ffd4e8;
  }
  .tab.active {
    background: linear-gradient(90deg, #ff6fa5, #c084fc);
    color: white;
    border-color: transparent;
  }
  .panel {
    max-width: 700px;
  }
  .event-item {
    background: rgba(255,255,255,0.75);
    border: 1px solid #ffd4e8;
    border-radius: 14px;
    padding: 14px 18px;
    margin-bottom: 10px;
    display: flex;
    justify-content: space-between;
    font-size: 13.5px;
  }
  .event-type {
    background: #fff2c2;
    color: #b8860b;
    font-weight: 700;
    font-size: 10.5px;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 20px;
    margin-right: 10px;
  }
  .contributor-row {
    display: flex;
    justify-content: space-between;
    background: rgba(255,255,255,0.75);
    border: 1px solid #ffd4e8;
    border-radius: 14px;
    padding: 14px 18px;
    margin-bottom: 10px;
  }
  textarea {
    width: 100%;
    min-height: 160px;
    border-radius: 14px;
    border: 1px solid #ffd4e8;
    padding: 16px;
    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    color: #6b4a5e;
    background: rgba(255,255,255,0.85);
    resize: vertical;
  }
  .save-btn {
    margin-top: 12px;
    background: linear-gradient(90deg, #ff6fa5, #c084fc);
    color: white;
    border: none;
    padding: 10px 22px;
    border-radius: 20px;
    font-weight: 600;
    cursor: pointer;
  }
</style>

<%= link_to "← Back to repos", root_path, class: "back-link" %>
<h1><%= @repository.full_name %></h1>

<div class="tabs">
  <%= link_to "Activity", repository_path(@repository, tab: "activity"), class: "tab #{'active' if @tab == 'activity'}" %>
  <%= link_to "Contributors", repository_path(@repository, tab: "contributors"), class: "tab #{'active' if @tab == 'contributors'}" %>
  <%= link_to "About", repository_path(@repository, tab: "about"), class: "tab #{'active' if @tab == 'about'}" %>
</div>

<div class="panel">
  <% if @tab == "activity" %>
    <% @events.each do |event| %>
      <div class="event-item">
        <div>
          <span class="event-type"><%= event.event_type %></span>
          by <strong><%= event.actor %></strong>
        </div>
        <span><%= time_ago_in_words(event.occurred_at) %> ago</span>
      </div>
    <% end %>

  <% elsif @tab == "contributors" %>
    <% @contributors.each do |actor, count| %>
      <div class="contributor-row">
        <span><%= actor %></span>
        <span><%= count %> events</span>
      </div>
    <% end %>

  <% elsif @tab == "about" %>
    <%= form_with model: @repository, local: true do |f| %>
      <%= f.text_area :about, placeholder: "Write something about this project..." %>
      <br>
      <%= f.submit "Save", class: "save-btn" %>
    <% end %>
  <% end %>
</div>