<div style="font-family: -apple-system, sans-serif; max-width: 480px; margin: 0 auto; padding: 24px; border: 1px solid #e0e0e0; border-radius: 8px;">
  <h2 style="margin-top: 0; color: #24292f;">🔔 New Activity</h2>
  <p style="font-size: 16px;">
    <strong><%= @event.actor %></strong> triggered a
    <strong><%= @event.event_type %></strong>
    <% if @event.action.present? %>(<%= @event.action %>)<% end %>
  </p>
  <p style="color: #57606a;">
    on <strong><%= @event.repo_full_name %></strong>
  </p>
  <p style="font-size: 13px; color: #8b949e; margin-top: 24px; border-top: 1px solid #e0e0e0; padding-top: 12px;">
    <%= @event.occurred_at.strftime("%B %d, %Y at %I:%M %p") %>
  </p>
</div>s